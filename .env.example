# 环境变量样例 —— 全部为占位值，无真实密钥。复制为 .env 后按需填写。

# Docker Compose PostgreSQL 配置
POSTGRES_USER=skillbench
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=skillbench

# PostgreSQL 16（本地开发或 Docker）
DATABASE_URL=postgresql+psycopg://skillbench:dev_password_change_me@localhost:5432/skillbench

# 对象存储（本地 MinIO，S3 兼容；生产选型待定）
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
S3_BUCKET_ARTIFACTS=artifacts
S3_BUCKET_EVIDENCE=evidence

# 来源采集（只访问公开来源，遵守限流；不绕过任何访问控制）
GITHUB_TOKEN=changeme
HF_TOKEN=changeme

# GitHub token for private benchmarks sync (Task 12b/13)
GITHUB_TOKEN_BENCHMARKS=ghp_your_token_here

# LLM 裁判池（四裁判池：GPT / Claude / 千问 / DeepSeek —— 仅作补充判分）
OPENAI_API_KEY=changeme
ANTHROPIC_API_KEY=changeme
QWEN_API_KEY=changeme
DEEPSEEK_API_KEY=changeme

# 测试成本上限（PRD 13.1：测试费用和外部调用必须受限）
TEST_COST_LIMIT_CNY_PER_RUN=1.0
TEST_COST_LIMIT_CNY_PER_DAY=100.0
TEST_MAX_EXTERNAL_CALLS_PER_RUN=20

